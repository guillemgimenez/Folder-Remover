#!/bin/sh
set -e
# Las dependencias de Python (customtkinter, send2trash) no están en apt: van en un venv propio.
if [ "$1" = "configure" ]; then
    python3 -m venv --system-site-packages /opt/folder-remover/venv
    /opt/folder-remover/venv/bin/pip install --disable-pip-version-check -q \
        -r /opt/folder-remover/requirements.txt
fi
exit 0
